[Unit]
Description=Sync display images from Google Drive
Documentation=https://github.com/peterbaker/lowertown-display-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
# flock guards against the 60s timer firing a second rclone while the previous
# one is still running (slow connection or large transfer). Exit code 75 means
# "lock held" — declared a clean success so systemd doesn't log it as failure.
SuccessExitStatus=75
ExecStart=/usr/bin/flock -n -E 75 /tmp/rclone-sync.lock /usr/bin/rclone sync gdrive:"Lowertown Display" /home/pi/display-drop \
  --drive-shared-with-me \
  --exclude-from /home/pi/display-bridge/.expired \
  --log-level INFO
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rclone-sync
