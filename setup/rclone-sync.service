[Unit]
Description=Sync display images from Google Drive
Documentation=https://github.com/peterbaker/lowertown-display-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
ExecStart=/usr/bin/rclone sync gdrive:"Lowertown Display" /home/pi/display-drop \
  --drive-shared-with-me \
  --exclude-from /home/pi/display-bridge/.expired \
  --log-level INFO
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rclone-sync
